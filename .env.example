# Local development (see .env.production for deploy)
NEXT_PUBLIC_API_URL=https://webapi.fasttesters.com
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_SITE_URL=https://fasttesters.com

# Google Tag Manager container ID (e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# MUST be the SAME GA4 stream the User Dashboard uses
# (NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID = G-X2WLH2X771) so marketing-site
# and app.fasttesters.com share one property for realtime + cross-domain.
# If left blank, the code falls back to NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-X2WLH2X771

# YouTube explainer embed for homepage CRO hero (video ID only, e.g. XCWEyjuLFx0)
NEXT_PUBLIC_EXPLAINER_VIDEO_ID=XCWEyjuLFx0

# Firebase web app config (Firebase Console → Project settings → Your apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Must match backend JWT_SECRET (used by Next.js middleware to verify admin sessions)
AUTH_JWT_SECRET=dev-secret-change-in-production

# Meta Pixel (shared with app.fasttesters.com)
NEXT_PUBLIC_META_PIXEL_ID=1768236327646862

# Meta Conversions API (server-side only — never expose to browser)
META_ACCESS_TOKEN=EAAp6rvSALN0BR8TQK2ECxEZB3IuZC89CjyWPfUOIsgAz6G2zr1rHvWCotgpM1EJTTfThp5Y7kyoLU2ZAjGyWqtnZBWPFMoyOvLlGLCyeLhK3YdImzqZBA9M9j0ZBMaq5XHr3ZBzt18UHbqxGjz4JeC0ZAbvbjHcCxGU1RZCP0jtpt2xsQaK0AnM5I8Y6T0nWfxwZDZD
META_API_VERSION=v23.0
META_TEST_EVENT_CODE=TEST69919
